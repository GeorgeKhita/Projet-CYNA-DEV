APP_NAME=CYNA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyna_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
CACHE_DRIVER=file

# Brevo — envoi d'emails via API HTTP (port 443).
# Fonctionne en local ET sur Railway (le SMTP est bloqué par Railway).
# Clé à générer sur https://app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=
# L'adresse expéditeur doit être vérifiée dans Brevo (Senders).
MAIL_FROM_ADDRESS=contact.cyna.app@gmail.com
MAIL_FROM_NAME="CYNA"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1
FRONTEND_URL=http://localhost:5173

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
